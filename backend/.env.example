# The room service runs independently from the frontend.
LISTENING_HOST=0.0.0.0
LISTENING_PORT=3030
# Maximum members per room, including the host (2-50).
LISTENING_ROOM_CAPACITY=10

# Optional comma-separated frontend origins. Empty allows LAN development.
# Example: https://music.example.com,http://localhost:5173
# Electron installations may use mappic://app as their origin.
LISTENING_ALLOWED_ORIGINS=

# Optional public backend origin used in shared invitations.
# Example: https://listen.example.com
LISTENING_PUBLIC_URL=
