{
  "name": "lanyin-music",
  "version": "1.0.0",
  "description": "澜音 desktop music app",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --configLoader native --host 0.0.0.0",
    "build": "node deploy/baota/package.mjs",
    "desktop:dev": "node scripts/desktop-dev.cjs",
    "desktop:build": "node scripts/prepare-runtime-env.cjs && vite build --configLoader native --mode desktop --outDir dist-desktop && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "axios": "^1.16.1",
    "lucide-vue-next": "^0.468.0",
    "naive-ui": "^2.42.0",
    "socket.io-client": "^4.8.4",
    "three": "^0.185.1",
    "vite": "^6.3.5",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.lanyin.music",
    "productName": "澜音",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      {
        "from": "dist-desktop",
        "to": "dist",
        "filter": ["**/*"]
      },
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
