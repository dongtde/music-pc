{
  "name": "lanyin-music",
  "version": "1.0.0",
  "description": "澜音 desktop music app",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "baseline:bundle": "node scripts/analyze-bundle.cjs",
    "smoke:routes": "node scripts/route-smoke.js",
    "smoke:first-screen": "node scripts/first-screen-smoke.js",
    "smoke:fps": "node scripts/fps-smoke.js",
    "smoke:player": "node scripts/player-smoke.js",
    "smoke:electron-proxy": "node scripts/electron-proxy-smoke.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:dev": "vite --host 127.0.0.1",
    "desktop:debug": "node scripts/desktop-debug.cjs",
    "desktop:start": "electron .",
    "desktop:build": "vite build --mode desktop && electron-builder --win --x64",
    "desktop:pack": "vite build --mode desktop && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "axios": "^1.16.1",
    "lucide-vue-next": "^0.468.0",
    "naive-ui": "^2.42.0",
    "vite": "^6.3.5",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.lanyin.music",
    "productName": "澜音",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
