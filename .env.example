# Frontend request base paths
VITE_KUGOU_API_BASE=/api
VITE_NETEASE_API_BASE=/netease-api
VITE_API_TIMEOUT=120000

# Vite forwards room connections to the separately started backend.
LISTENING_API_TARGET=http://127.0.0.1:3030
# Optional public backend origin for direct browser/Electron connections.
# Leave empty for web development through the Vite proxy.
VITE_LISTENING_SERVER_URL=

# Fill these in locally with your own backend proxy targets.
# Keep real values in .env, .env.local, or deployment environment variables.
VITE_KUGOU_API_TARGET=
VITE_NETEASE_API_TARGET=

# Desktop development
VITE_DEV_SERVER_URL=http://127.0.0.1:5173
VITE_DEV_SERVER_PORT=5174
