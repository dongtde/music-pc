# Nginx exposes the website and forwards room traffic to this local listener.
LISTENING_HOST=127.0.0.1
LISTENING_PORT=3030
LISTENING_ROOM_CAPACITY=10

# Set these to the website origin when its IP/domain has been confirmed.
# Example: https://music.example.com (no /space or other path).
LISTENING_ALLOWED_ORIGINS=
LISTENING_PUBLIC_URL=
